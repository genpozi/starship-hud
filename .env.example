# STELLARIS-7 orbit server — operator credentials
# Copy to .env and fill in to enable the LLM-backed mission planner.
# Without these the planner falls back to the deterministic heuristic engine.

# HTTP port for the orbit server (default 3001)
PORT=3001

# Runtime state directory override (default <repo>/data)
# Useful for running multiple isolated instances or self-contained tests.
# STELLARIS_DATA_DIR=/tmp/stellaris-runtime

# Your own API key (never commit the real value)
USER_LLM_API_KEY=

# OpenAI-compatible endpoint
USER_LLM_BASE_URL=https://api.deepseek.com/v1

# Model name
USER_LLM_MODEL=deepseek-chat

# GitHub sync (optional — demo data is used when absent)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_POLL_MS=180000

# Hermes WebUI bridge (optional — the module is ACTIVE only when
# USER_HERMES_URL is set; otherwise skills fall back to simulated delegation)
USER_HERMES_URL=
USER_HERMES_PASSWORD=
USER_HERMES_MODEL=
USER_HERMES_POLL_MS=180000
# Reverse ingest poll interval — sessions/crons → kanban/items/scheduler/alerts
USER_HERMES_INGEST_MS=60000
# Approval policy for Hermes tool calls: prompt (HUD card) | always | never
USER_HERMES_APPROVAL=prompt
# Max ms an approval request waits for the operator before timing out
USER_HERMES_APPROVAL_TIMEOUT=120000

# Test double only — password the bundled mock hermes-webui requires
# (scripts/demo.sh sets MOCK_PASSWORD=local-dev by default)
# MOCK_PASSWORD=
